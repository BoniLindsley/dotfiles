#!/usr/bin/env bash

__help() {
  cat <<HELP
Usage: ${script_name} [--help] [--build] [--tool NAME | --no-tools]...
                         [--package NAME | --no-packages]... [--no-save]
                         [--] [claude arguments...]
       ${script_name} [--build] [--tool NAME]... --install-tool NAME [--] [command...]

Run Claude Code in an isolated Docker container.

  -h, --help              Show this help
  -b, --build             Rebuild the Docker image (also how Claude Code gets updated)
  -t, --tool NAME         Make tool NAME available (repeatable; saved for the
                          project)
  --no-tools              Make no tools available (saved for the project)
  --package NAME          Add Debian package NAME to the image (repeatable;
                          saved for the project)
  --no-packages           Use the base image without extra packages (saved
                          for the project)
  --no-save               Use these options for this run only
  --install-tool NAME     Run command in a container that can write to tool NAME
  --list-tools            List the installed tools
  --                      Pass remaining arguments directly to Claude Code

Environment:
  DOCKERED_CLAUDE_IMAGE   Image name (default: dockered-claude:latest)
  DOCKERED_CLAUDE_HOME    Host state directory (default: \$XDG_STATE_HOME/dockered-claude
                          or \$HOME/.local/state/dockered-claude)
  DOCKERED_CLAUDE_TOOLS   Space-separated tools to use when neither --tool nor
                          the project configuration gives any
  DOCKERED_CLAUDE_TOOLS_DIR
                          Host tools directory (default: \$XDG_DATA_HOME/dockered-claude/tools
                          or \$HOME/.local/share/dockered-claude/tools)

  Passed through when set: ANTHROPIC_API_KEY, CLAUDE_CODE_OAUTH_TOKEN,
  ANTHROPIC_BASE_URL, ANTHROPIC_MODEL

Skills:
  ~/.agents is mounted read-only. Claude Code does not read ~/.agents/skills,
  so each skill there is symlinked into the container's ~/.claude/skills,
  which stays writable for skills synced from claude.ai.

Configuration:
  ~/.config/claude is mounted read-only, and each entry in it is symlinked
  into the container's ~/.claude (e.g. settings.json), so the configuration
  is managed on the host while the rest of ~/.claude stays writable state.
  ~/.config/git is mounted read-only, so git uses the host's configuration.

Project configuration:
  ${project_config_path} holds options for a project as "KEY = VALUE"
  lines and # comments. It is read as data and never run. It is looked for
  in the working directory and its parents below \$HOME, then in the main
  worktree of the git repository.

  --tool, --no-tools, --package and --no-packages are saved to it,
  replacing the line for their key and keeping all other lines; packages
  are saved only once their image has been built. When there is no file
  yet, it is created in the main worktree, or else in the working
  directory. .meta/ is excluded from git through info/exclude unless it is
  ignored already. The directory is mounted read-only in the container,
  since the launcher reads it on the host. Install runs (--install-tool)
  neither read nor save it.

  tools = NAME...         Tools to use when no --tool is given
  packages = NAME...      Debian packages to add when no --package is given

  Packages are installed in an image derived from the base image, tagged
  by a hash of the sorted package names (as in
  dockered-claude:packages-3f9a1c2b4d5e), so projects with the same
  packages share it. It is rebuilt with --build and whenever the base
  image has changed. Remove unused ones with:
  docker image prune --all --filter label=dockered-claude.packages
  (they are rebuilt when next needed). Tools are installed (--install-tool)
  on the base image, since they are shared between projects.

Tools:
  Each tool is a prefix directory in the tools directory, with its
  executables in bin/. A selected tool is mounted read-only at
  /opt/tools/NAME and /opt/tools/NAME/bin is put in front of PATH, so tools
  may consist of many files (e.g. an npm package) and the first tool
  selected wins on name collisions.

  A tool may also have an env file in its directory, in docker's --env-file
  format, to set variables it needs (e.g. VCPKG_ROOT=/opt/tools/vcpkg/root).
  It must not set PATH. The first tool selected wins on name collisions here
  too.

  Tools are installed from inside the image, at the path they are mounted
  at, so that absolute paths and native code match the container. The
  install container mounts the tool writable at /opt/tools/NAME, makes it
  the working directory, and points installers at it:
  NPM_CONFIG_PREFIX, UV_TOOL_DIR (NAME/venvs), UV_TOOL_BIN_DIR (NAME/bin)
  and UV_PYTHON_INSTALL_DIR (NAME/python). HOME is a temporary directory.
  Static binaries can instead be copied into the tool's bin/ on the host.

  Known tools install with a built-in command when none is given:
  ${known_tools[*]}. Run again to update. A selected tool that is not
  installed yet is installed with its built-in command before Claude Code
  starts; other tools must be installed with --install-tool first. A tool
  counts as installed once its bin/ is not empty.

Examples:
  ${script_name}
  ${script_name} --build
  ${script_name} -- --help
  ${script_name} -p 'run the tests'
  ${script_name} --tool rclone --tool typescript
  ${script_name} --install-tool typescript
  ${script_name} --install-tool vcpkg
  ${script_name} --install-tool prettier -- npm install --global prettier
  ${script_name} --install-tool ruff -- uv tool install ruff
HELP
}

warn() {
  printf '%s: %s\n' "${script_name}" "$*" >&2
}

parse_arguments() {
  declare argument
  while (($#)); do
    argument="$1"
    shift
    case "${argument}" in
    -h | --help) kwargs[help]=1 ;;
    -b | --build) kwargs[build]=1 ;;
    -t | --tool | --install-tool)
      if (($# == 0)); then
        warn "${argument} requires a tool name"
        return 1
      fi
      validate_tool_name "$1" || return
      if [[ "${argument}" == --install-tool ]]; then
        kwargs[install_tool]="$1"
      else
        tools+=("$1")
        kwargs[tools_given]=1
      fi
      shift
      ;;
    --no-tools)
      tools=()
      kwargs[tools_given]=1
      ;;
    --package)
      if (($# == 0)); then
        warn "${argument} requires a package name"
        return 1
      fi
      validate_package_name "$1" || return
      packages+=("$1")
      kwargs[packages_given]=1
      shift
      ;;
    --no-packages)
      packages=()
      kwargs[packages_given]=1
      ;;
    --no-save) kwargs[no_save]=1 ;;
    --list-tools) kwargs[list_tools]=1 ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("${argument}" "$@")
      break
      ;;
    esac
  done
}

resolve_paths() {
  workdir="$(pwd -P)" || return
  image="${DOCKERED_CLAUDE_IMAGE:-dockered-claude:latest}"
  # The image containers run, which ensure_packages_image may change.
  container_image="${image}"
  uid_host="$(id -u)" || return
  gid_host="$(id -g)" || return
  username="$(id -un)" || return
  groupname="$(id -gn)" || return

  # The container home lives under the mounted /home tree, so the
  # username-specific directory does not need to exist in the read-only image.
  home="/home/${username}"
  state_dir="${DOCKERED_CLAUDE_HOME:-${XDG_STATE_HOME:-${HOME:?}/.local/state}/dockered-claude}"
  state_home="${state_dir}/home/${username}"
  passwd_file="${state_dir}/etc/passwd"
  group_file="${state_dir}/etc/group"
  agents_dir="${HOME:?}/.agents"
  config_dir="${HOME:?}/.config/claude"
  git_config_dir="${HOME:?}/.config/git"
  tools_dir="${DOCKERED_CLAUDE_TOOLS_DIR:-${XDG_DATA_HOME:-${HOME:?}/.local/share}/dockered-claude/tools}"
}

# Choose the tools from --tool and --no-tools,
# else from the project configuration (empty for install runs),
# else from DOCKERED_CLAUDE_TOOLS.
select_tools() {
  [[ -z "${kwargs[tools_given]+defined}" ]] || return 0
  if [[ -n "${project_options[tools]+defined}" ]]; then
    read -r -a tools <<<"${project_options[tools]}"
  else
    read -r -a tools <<<"${DOCKERED_CLAUDE_TOOLS:-}"
  fi
  declare tool
  for tool in "${tools[@]}"; do
    validate_tool_name "${tool}" || return
  done
}

# Tool names become path components on the host and in the container.
validate_tool_name() {
  declare name="$1"
  if [[ ! "${name}" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
    warn "invalid tool name '${name}'"
    return 1
  fi
}

# Choose the packages from --package and --no-packages,
# else from the project configuration.
select_packages() {
  [[ -z "${kwargs[packages_given]+defined}" ]] || return 0
  read -r -a packages <<<"${project_options[packages]:-}"
  declare package
  for package in "${packages[@]}"; do
    validate_package_name "${package}" || return
  done
}

# Package names are expanded unquoted in a RUN instruction,
# so only Debian's own syntax for them is accepted.
validate_package_name() {
  declare name="$1"
  if [[ ! "${name}" =~ ^[a-z0-9][a-z0-9+.-]+$ ]]; then
    warn "invalid package name '${name}'"
    return 1
  fi
}

# A tool is installed once its bin/ has an entry,
# since an install that failed may have left an empty one.
tool_installed() {
  declare tool="$1"
  [[ -n "$(ls -A -- "${tools_dir}/${tool}/bin" 2>/dev/null)" ]]
}

check_tool_installed() {
  declare tool="$1"
  if ! tool_installed "${tool}"; then
    warn "tool '${tool}' is not installed:" \
      "${tools_dir}/${tool}/bin is missing or empty"
    return 1
  fi
}

# Install each selected tool that is not installed yet
# with its built-in install command,
# in a container without the other selected tools.
install_missing_tools() {
  declare tool
  for tool in "${tools[@]}"; do
    tool_installed "${tool}" && continue
    if [[ " ${known_tools[*]} " != *" ${tool} "* ]]; then
      warn "tool '${tool}' is not installed and has no built-in install" \
        "command; install it with: ${script_name} --install-tool ${tool}" \
        "-- COMMAND"
      return 1
    fi
    warn "installing tool '${tool}'"
    (
      tools=()
      install_tool "${tool}"
    ) || return
    check_tool_installed "${tool}" || return
  done
}

declare project_config_path='.meta/dockered-claude/config'

# The project configuration is kept with the project's agent state in .meta/,
# which is excluded from git,
# so a cloned repository cannot bring its own.
# Set project_config to the first one found
# walking up from the working directory, stopping below $HOME,
# or else in the main worktree of the git repository;
# failing both, to where a new one would be created.
find_project_config() {
  declare directory="${workdir}" home_host main_worktree='' common_dir
  home_host="$(cd -- "${HOME:?}" && pwd -P)" || return

  while [[ "${directory}" != / && "${directory}" != "${home_host}" ]]; do
    if [[ -f "${directory}/${project_config_path}" ]]; then
      project_config="${directory}/${project_config_path}"
      return 0
    fi
    directory="$(dirname -- "${directory}")" || return
  done

  if common_dir="$(git -C "${workdir}" rev-parse --path-format=absolute \
    --git-common-dir 2>/dev/null)" && [[ "${common_dir}" == */.git ]]; then
    main_worktree="${common_dir%/.git}"
  fi
  project_config="${main_worktree:-${workdir}}/${project_config_path}"
}

# Read project_config into project_options.
# Each line is blank, a comment,
# or "KEY = VALUE" with a known KEY set at most once.
read_project_config() {
  [[ -f "${project_config}" ]] || return 0
  declare line key value
  declare -i number=0
  declare skip='^[[:space:]]*(#|$)'
  declare setting='^[[:space:]]*([a-z]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])?[[:space:]]*$'

  while IFS= read -r line || [[ -n "${line}" ]]; do
    number+=1
    [[ "${line}" =~ ${skip} ]] && continue
    if [[ ! "${line}" =~ ${setting} ]]; then
      warn "${project_config}:${number}: expected KEY = VALUE"
      return 1
    fi
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    case "${key}" in
    tools | packages) ;;
    *)
      warn "${project_config}:${number}: unknown key '${key}'"
      return 1
      ;;
    esac
    if [[ -n "${project_options[${key}]+defined}" ]]; then
      warn "${project_config}:${number}: '${key}' is set more than once"
      return 1
    fi
    project_options[${key}]="${value}"
  done <"${project_config}"
}

# Save the options given on the command line, unless --no-save is given.
# Called once the image is built,
# so that a misspelt package, which only the build reveals, is not saved.
save_project_options() {
  [[ -z "${kwargs[no_save]+defined}" ]] || return 0
  if [[ -n "${kwargs[tools_given]+defined}" ]]; then
    declare tool
    for tool in "${tools[@]}"; do
      check_tool_installed "${tool}" || return
    done
    save_project_option tools "${tools[*]}" || return
  fi
  if [[ -n "${kwargs[packages_given]+defined}" ]]; then
    save_project_option packages "${packages[*]}" || return
  fi
}

# Save KEY = VALUE to project_config if VALUE differs from the current one,
# replacing the line for KEY and keeping every other line,
# and say so.
save_project_option() {
  declare key="$1" value="$2"
  if [[ -n "${project_options[${key}]+defined}" &&
    "${project_options[${key}]}" == "${value}" ]]; then
    return 0
  fi

  declare directory="${project_config%/*}"
  declare root="${project_config%/"${project_config_path}"}"
  declare setting="${key} =${value:+ ${value}}"
  declare line temporary replaced=''
  declare pattern="^[[:space:]]*${key}[[:space:]]*="

  mkdir -p -- "${directory}" || return
  exclude_meta_directory "${root}" || return

  # Written to a temporary file in the same directory
  # and renamed over the configuration,
  # so an interrupted run cannot leave half a file.
  temporary="$(mktemp -- "${directory}/.config.XXXXXX")" || return
  {
    if [[ -f "${project_config}" ]]; then
      while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ "${line}" =~ ${pattern} ]]; then
          printf '%s\n' "${setting}"
          replaced=1
        else
          printf '%s\n' "${line}"
        fi
      done <"${project_config}"
    else
      printf '%s\n' \
        "# ${script_name} options for this project, saved from the command line" \
        "# (see ${script_name} --help)."
    fi
    [[ -n "${replaced}" ]] || printf '%s\n' "${setting}"
  } >"${temporary}" &&
    mv -f -- "${temporary}" "${project_config}" || {
    rm -f -- "${temporary}"
    return 1
  }

  project_options[${key}]="${value}"
  warn "saved '${setting}' to ${project_config}"
}

# Exclude .meta/ at root from git through info/exclude,
# which is not itself tracked,
# unless root is not in a work tree or .meta/ is ignored already.
exclude_meta_directory() {
  declare root="$1" exclude prefix
  git -C "${root}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  git -C "${root}" check-ignore -q -- .meta/ && return 0
  prefix="$(git -C "${root}" rev-parse --show-prefix)" || return
  exclude="$(git -C "${root}" rev-parse --path-format=absolute \
    --git-path info/exclude)" || return
  mkdir -p -- "${exclude%/*}" || return
  printf '/%s.meta/\n' "${prefix}" >>"${exclude}" || return
  warn "excluded /${prefix}.meta/ from git in ${exclude}"
}

list_tools() {
  [[ -d "${tools_dir}" ]] || return 0
  declare entry
  for entry in "${tools_dir}"/*/; do
    entry="${entry%/}"
    tool_installed "${entry##*/}" || continue
    printf '%s\n' "${entry##*/}"
  done
}

prepare_state_directory() {
  # Claude Code keeps its state in ~/.claude/ and ~/.claude.json; both end
  # up inside the persisted home directory.
  # The passwd and group files live in etc/, mirroring their mount paths.
  mkdir -p -- "${state_home}/.claude/skills" "${state_dir}/etc" || return
  chmod 700 -- "${state_dir}" "${state_dir}/etc" "${state_dir}/home" \
    "${state_home}" "${state_home}/.claude" || return
}

# Docker creates missing mount points as root. Under /home, which is the
# persisted state directory, that would leave root-owned directories on the
# host (e.g. ~/src for a workdir ~/src/project) that the user can neither
# write to nor remove, so create the mount point and its parents as the user.
prepare_home_mount_point() {
  declare destination="$1"
  [[ "${destination}" == /home/?* ]] || return 0

  declare directory="${state_dir}/home"
  declare component
  declare -a components
  IFS=/ read -r -a components <<<"${destination#/home/}"
  for component in "${components[@]}"; do
    directory+="/${component}"
    [[ -e "${directory}" ]] || break
    if [[ ! -O "${directory}" ]]; then
      warn "${directory} is not owned by ${username}" \
        "(probably created by Docker in an earlier run);" \
        "fix it with: sudo chown -R ${uid_host}:${gid_host} '${directory}'"
      return 0
    fi
  done

  mkdir -p -- "${state_dir}${destination}"
}

prepare_mount_points() {
  prepare_home_mount_point "${workdir}" || return
  if [[ -d "${agents_dir}" ]]; then
    prepare_home_mount_point "${home}/.agents" || return
  fi
  if [[ -d "${config_dir}" ]]; then
    prepare_home_mount_point "${home}/.config/claude" || return
  fi
  if [[ -d "${git_config_dir}" ]]; then
    prepare_home_mount_point "${home}/.config/git" || return
  fi
}

prepare_user_identity() {
  printf 'root:x:0:0:root:/root:/bin/bash\n%s:x:%s:%s:%s:%s:/bin/bash\n' \
    "${username}" "${uid_host}" "${gid_host}" "${username}" "${home}" \
    >"${passwd_file}" || return
  printf 'root:x:0:\n%s:x:%s:\n' "${groupname}" "${gid_host}" \
    >"${group_file}" || return
  chmod 600 -- "${passwd_file}" "${group_file}" || return
}

# Symlink each skill in ~/.agents/skills
# into the persisted ~/.claude/skills,
# using relative path ../../.agents/skills/<name>.
link_agent_skills() {
  declare skills_source="${agents_dir}/skills"
  declare skills_target="${state_home}/.claude/skills"
  declare link_prefix='../../.agents/skills/'
  declare entry name link target

  # Drop links from earlier runs whose skill has since been removed.
  for link in "${skills_target}"/*; do
    [[ -L "${link}" ]] || continue
    target="$(readlink -- "${link}")" || return
    [[ "${target}" == "${link_prefix}"* ]] || continue
    name="${link##*/}"
    if [[ ! -f "${skills_source}/${name}/SKILL.md" ]]; then
      rm -f -- "${link}" || return
    fi
  done

  [[ -d "${skills_source}" ]] || return 0

  for entry in "${skills_source}"/*/; do
    [[ -f "${entry}SKILL.md" ]] || continue
    entry="${entry%/}"
    name="${entry##*/}"
    link="${skills_target}/${name}"

    # Claude Code reserves "synced" (any case) for skills from claude.ai.
    if [[ "${name,,}" == synced ]]; then
      warn "skipping skill '${name}': the name is reserved by Claude Code"
      continue
    fi
    if [[ -L "${link}" ]]; then
      target="$(readlink -- "${link}")" || return
      [[ "${target}" == "${link_prefix}${name}" ]] && continue
      warn "skipping skill '${name}': ${link} already links to ${target}"
      continue
    fi
    if [[ -e "${link}" ]]; then
      warn "skipping skill '${name}': ${link} already exists"
      continue
    fi
    ln -s -- "${link_prefix}${name}" "${link}" || return
  done
}

# Symlink each entry in ~/.config/claude
# into the persisted ~/.claude,
# using relative path ../.config/claude/<name>.
link_config_files() {
  declare config_target="${state_home}/.claude"
  declare link_prefix='../.config/claude/'
  declare entry name link target

  # Drop links from earlier runs whose file has since been removed.
  for link in "${config_target}"/* "${config_target}"/.[!.]*; do
    [[ -L "${link}" ]] || continue
    target="$(readlink -- "${link}")" || return
    [[ "${target}" == "${link_prefix}"* ]] || continue
    name="${link##*/}"
    if [[ ! -e "${config_dir}/${name}" ]]; then
      rm -f -- "${link}" || return
    fi
  done

  [[ -d "${config_dir}" ]] || return 0

  for entry in "${config_dir}"/* "${config_dir}"/.[!.]*; do
    [[ -e "${entry}" ]] || continue
    name="${entry##*/}"
    link="${config_target}/${name}"

    if [[ -L "${link}" ]]; then
      target="$(readlink -- "${link}")" || return
      [[ "${target}" == "${link_prefix}${name}" ]] && continue
      warn "skipping config '${name}': ${link} already links to ${target}"
      continue
    fi
    if [[ -e "${link}" ]]; then
      warn "skipping config '${name}': ${link} already exists"
      continue
    fi
    ln -s -- "${link_prefix}${name}" "${link}" || return
  done
}

image_exists() {
  docker image inspect "${image}" >/dev/null 2>&1
}

build_image() {
  docker build \
    --pull \
    --tag "${image}" \
    "${project_directory}" || return
}

ensure_image() {
  if [[ -n "${kwargs[build]+defined}" ]] || ! image_exists; then
    build_image || return
  fi
}

# Run containers from an image with the selected packages
# on top of the base image,
# tagged by a hash of their sorted names
# so that projects with the same packages share it.
# Build it with --build, when it is missing,
# or when it was built from another base image.
ensure_packages_image() {
  ((${#packages[@]} > 0)) || return 0
  declare repository="${image}" names hash base_id built_from
  # Drop the tag, but not a registry port (e.g. host:5000/name).
  [[ "${repository##*/}" != *:* ]] || repository="${repository%:*}"
  names="$(printf '%s\n' "${packages[@]}" | sort -u | paste -s -d ' ')" || return
  hash="$(printf '%s\n' "${names}" | sha256sum)" || return
  container_image="${repository}:packages-${hash:0:12}"

  base_id="$(docker image inspect --format '{{.Id}}' "${image}")" || return
  if [[ -z "${kwargs[build]+defined}" ]] &&
    built_from="$(docker image inspect \
      --format '{{index .Config.Labels "dockered-claude.base-image"}}' \
      "${container_image}" 2>/dev/null)" &&
    [[ "${built_from}" == "${base_id}" ]]; then
    return 0
  fi

  docker build \
    --build-arg "BASE_IMAGE=${image}" \
    --build-arg "BASE_IMAGE_ID=${base_id}" \
    --build-arg "PACKAGES=${names}" \
    --file "${project_directory}/Dockerfile.packages" \
    --tag "${container_image}" \
    "${project_directory}" || return
}

# The docker run arguments shared by Claude Code and tool install containers.
# SYS_PTRACE is only usable through the file capability on gdb in the image,
# which no-new-privileges would ignore,
# so that option is not set.
add_base_arguments() {
  docker_args+=(
    run
    --cap-add SYS_PTRACE
    --cap-drop ALL
    --env "TERM=${TERM:-xterm-256color}"
    --init
    --interactive
    --mount "type=bind,src=${group_file},dst=/etc/group,readonly"
    --mount "type=bind,src=${passwd_file},dst=/etc/passwd,readonly"
    --read-only
    --rm
    --security-opt seccomp=unconfined
    --tmpfs '/tmp:rw,exec,nosuid,nodev,mode=1777'
    --user "${uid_host}:${gid_host}"
  )

  # Allocate a TTY only when attached to one, so piping works
  # (e.g. `git diff | dockered-claude -p 'review this'`).
  if [[ -t 0 && -t 1 ]]; then
    docker_args+=(--tty)
  fi
}

# Mount each selected tool read-only at /opt/tools/<name> and put its bin/
# in front of the image's PATH, in selection order. The tool being installed
# (if any) is mounted writable by the caller, but its bin/ is put on PATH
# here so the install command sees a consistent PATH.
# A tool's env file, if any, is passed with --env-file.
# Later files override earlier ones,
# so they are passed in reverse order to let the first tool win.
add_tool_arguments() {
  declare writable_tool="${1:-}"
  declare env_file image_path tool tool_path=''
  declare -a env_args=()
  declare -A seen=()

  for tool in "${tools[@]}" ${writable_tool:+"${writable_tool}"}; do
    [[ -z "${seen[${tool}]+defined}" ]] || continue
    seen[${tool}]=1
    tool_path+="/opt/tools/${tool}/bin:"
    env_file="${tools_dir}/${tool}/env"
    if [[ -f "${env_file}" ]]; then
      if grep -Eq '^[[:space:]]*PATH([[:space:]]*=|[[:space:]]*$)' "${env_file}"; then
        warn "${env_file} must not set PATH"
        return 1
      fi
      env_args=(--env-file "${env_file}" "${env_args[@]}")
    fi
    [[ "${tool}" == "${writable_tool}" ]] && continue
    check_tool_installed "${tool}" || return
    docker_args+=(
      --mount "type=bind,src=${tools_dir}/${tool},dst=/opt/tools/${tool},readonly"
    )
  done

  [[ -n "${tool_path}" ]] || return 0
  docker_args+=("${env_args[@]}")
  image_path="$(docker image inspect \
    --format '{{range .Config.Env}}{{println .}}{{end}}' "${container_image}" |
    sed -n 's/^PATH=//p')" || return
  if [[ -z "${image_path}" ]]; then
    warn "cannot determine the PATH of image ${container_image}"
    return 1
  fi
  docker_args+=(--env "PATH=${tool_path}${image_path}")
}

declare -a known_tools=(rclone typescript uv vcpkg)

# Set install_command to the built-in install command for a known tool.
# It runs in the install container, with the tool's prefix as the working
# directory; the downloads are the projects' official release archives.
known_install_command() {
  declare tool="$1"
  case "${tool}" in
  rclone)
    install_command=(sh -c '
      set -eu
      case "$(uname -m)" in
      x86_64) arch=amd64 ;;
      aarch64) arch=arm64 ;;
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
      esac
      tmp="$(mktemp -d)"
      curl -fsSL -o "${tmp}/rclone.zip" \
        "https://downloads.rclone.org/rclone-current-linux-${arch}.zip"
      python3 -m zipfile -e "${tmp}/rclone.zip" "${tmp}"
      install -D -m 755 "${tmp}"/rclone-*-linux-"${arch}"/rclone bin/rclone
      rm -rf "${tmp}"
      bin/rclone version
    ')
    ;;
  typescript)
    install_command=(sh -c '
      set -eu
      npm install --global typescript
      bin/tsc --version
    ')
    ;;
  uv)
    install_command=(sh -c '
      set -eu
      case "$(uname -m)" in
      x86_64 | aarch64) arch="$(uname -m)" ;;
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
      esac
      mkdir -p bin
      curl -fsSL \
        "https://github.com/astral-sh/uv/releases/latest/download/uv-${arch}-unknown-linux-gnu.tar.gz" |
        tar -xz --strip-components=1 -C bin
      bin/uv --version
    ')
    ;;
  vcpkg)
    install_command=(sh -c '
      set -eu
      # A full clone,
      # since manifests pin port versions to commits in its history
      # (builtin-baseline).
      if [ -d root/.git ]; then
        git -C root pull --ff-only
      else
        git clone https://github.com/microsoft/vcpkg root
      fi
      root/bootstrap-vcpkg.sh -disableMetrics
      # The root is mounted read-only,
      # so vcpkg must run in manifest mode,
      # with build trees in vcpkg_installed/ of the project
      # and downloads and binary caches in ~/.cache/vcpkg.
      printf "%s\n" "{\"readonly\": true}" >root/vcpkg-bundle.json
      ln -sfn ../root/vcpkg bin/vcpkg
      printf "VCPKG_ROOT=%s\n" "${PWD}/root" >env
      bin/vcpkg version
    ')
    ;;
  *) return 1 ;;
  esac
}

# Run an install command for TOOL, or else its built-in one,
# in a container where the tool's prefix is writable
# at the same path it is later mounted at read-only.
# Tools are shared between projects, so they are installed on the base image.
install_tool() {
  declare tool="$1"
  shift
  declare prefix="/opt/tools/${tool}"
  declare container_image="${image}"
  declare -a docker_args=() install_command=()

  if (($# == 0)); then
    if ! known_install_command "${tool}"; then
      warn "no built-in install command for '${tool}'; give one after --" \
        "(built-in: ${known_tools[*]})"
      return 1
    fi
    set -- "${install_command[@]}"
  fi

  # Created here so that Docker does not create it as root.
  mkdir -p -- "${tools_dir}/${tool}/bin" || return

  add_base_arguments || return
  add_tool_arguments "${tool}" || return
  docker_args+=(
    --entrypoint "$1"
    --env HOME=/tmp
    --env "NPM_CONFIG_PREFIX=${prefix}"
    --env "UV_PYTHON_INSTALL_DIR=${prefix}/python"
    --env "UV_TOOL_BIN_DIR=${prefix}/bin"
    --env "UV_TOOL_DIR=${prefix}/venvs"
    --mount "type=bind,src=${tools_dir}/${tool},dst=${prefix}"
    --workdir "${prefix}"
  )
  shift

  docker "${docker_args[@]}" "${container_image}" "$@"
}

run_container() {
  declare -a docker_args=()
  add_base_arguments || return
  add_tool_arguments || return
  docker_args+=(
    --env "HOME=${home}"
    --mount "type=bind,src=${state_dir}/home,dst=/home"
    --mount "type=bind,src=${workdir},dst=${workdir}"
    --workdir "${workdir}"
  )

  # The launcher reads the project configuration on the host,
  # so it must not be writable from the container.
  declare project_config_dir="${project_config%/*}"
  if [[ -d "${project_config_dir}" && "${project_config_dir}" == "${workdir}/"* ]]; then
    docker_args+=(
      --mount "type=bind,src=${project_config_dir},dst=${project_config_dir},readonly"
    )
  fi

  declare variable
  for variable in ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN \
    ANTHROPIC_BASE_URL ANTHROPIC_MODEL; do
    if [[ -n "${!variable:-}" ]]; then
      docker_args+=(--env "${variable}")
    fi
  done

  if [[ -d "${agents_dir}" ]]; then
    docker_args+=(
      --mount "type=bind,src=${agents_dir},dst=${home}/.agents,readonly"
    )
  fi
  if [[ -d "${config_dir}" ]]; then
    docker_args+=(
      --mount "type=bind,src=${config_dir},dst=${home}/.config/claude,readonly"
    )
  fi
  if [[ -d "${git_config_dir}" ]]; then
    docker_args+=(
      --mount "type=bind,src=${git_config_dir},dst=${home}/.config/git,readonly"
    )
  fi

  exec docker "${docker_args[@]}" "${container_image}" "$@"
}

main() {
  declare script_path
  script_path="$(realpath -- "${BASH_SOURCE[0]}")" || return
  declare script_name
  script_name="$(basename -- "${script_path}")" || return
  declare script_directory
  script_directory="$(dirname -- "${script_path}")" || return
  declare project_directory
  project_directory="$(dirname -- "${script_directory}")" || return

  declare image workdir state_dir state_home uid_host gid_host username groupname
  declare home passwd_file group_file agents_dir config_dir git_config_dir
  declare tools_dir project_config container_image
  declare -A kwargs=() project_options=()
  declare -a args=() tools=() packages=()

  parse_arguments "$@" || return
  if [[ -n "${kwargs[help]+defined}" ]]; then
    __help
    return
  fi

  resolve_paths || return
  if [[ -n "${kwargs[list_tools]+defined}" ]]; then
    list_tools
    return
  fi

  prepare_state_directory || return
  if [[ -n "${kwargs[install_tool]+defined}" ]]; then
    select_tools || return
    prepare_user_identity || return
    ensure_image || return
    install_tool "${kwargs[install_tool]}" "${args[@]}" || return
    return
  fi

  find_project_config || return
  read_project_config || return
  select_tools || return
  select_packages || return
  prepare_mount_points || return
  prepare_user_identity || return
  link_agent_skills || return
  link_config_files || return
  ensure_image || return
  install_missing_tools || return
  ensure_packages_image || return
  save_project_options || return
  run_container "${args[@]}" || return
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  main "$@"
fi
