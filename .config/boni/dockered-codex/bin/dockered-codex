#!/usr/bin/env bash

__help() {
  cat <<HELP
Usage: ${script_name} [--help] [--build] [--] [codex arguments...]

Run Codex in an isolated Docker container.

  -h, --help    Show this help
  -b, --build   Rebuild the Docker image
  --            Pass remaining arguments directly to Codex

Environment:
  CODEX_DOCKER_IMAGE   Image name (default: codex-tui:latest)
  CODEX_DOCKER_HOME    Host state directory (default: \$XDG_STATE_HOME/codex-docker
                       or \$HOME/.local/state/codex-docker)

Examples:
  ${script_name}
  ${script_name} --build
  ${script_name} -- --help
  ${script_name} exec 'run the tests'
HELP
}

parse_arguments() {
  declare argument
  while (($#)); do
    argument="$1"
    shift
    case "${argument}" in
    -h | --help) kwargs[help]=1 ;;
    -b | --build) kwargs[build]=1 ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("${argument}" "$@")
      break
      ;;
    esac
  done
}

resolve_paths() {
  workdir="$(pwd -P)" || return
  image="${CODEX_DOCKER_IMAGE:-dockered-codex:latest}"
  uid_host="$(id -u)" || return
  gid_host="$(id -g)" || return
  username="$(id -un)" || return
  groupname="$(id -gn)" || return

  # Docker mounts the entire /home tree, so the username-specific mount
  # target does not need to exist in the read-only image beforehand.
  home="${HOME-"/home/${username}"}"
  state_dir="${CODEX_DOCKER_HOME:-${XDG_STATE_HOME:-${HOME:?}/.local/state}/codex-docker}"
  passwd_file="${state_dir}/passwd"
  group_file="${state_dir}/group"
}

prepare_state_directory() {
  mkdir -p -- "${state_dir}/home/${username}/.codex" || return
  chmod 700 -- "${state_dir}" "${state_dir}/home" \
    "${state_dir}/home/${username}" "${state_dir}/home/${username}/.codex" || return
}

prepare_user_identity() {
  printf 'root:x:0:0:root:/root:/bin/bash\n%s:x:%s:%s:%s:%s:/bin/bash\n' \
    "${username}" "${uid_host}" "${gid_host}" "${username}" "${home}" \
    >"${passwd_file}" || return
  printf 'root:x:0:\n%s:x:%s:\n' "${groupname}" "${gid_host}" \
    >"${group_file}" || return
  chmod 600 -- "${passwd_file}" "${group_file}" || return
}

image_exists() {
  docker image inspect "${image}" >/dev/null 2>&1
}

build_image() {
  docker build \
    --pull \
    --tag "${image}" \
    "${project_directory}" || return
}

ensure_image() {
  if [[ -n "${kwargs[build]+defined}" ]] || ! image_exists; then
    build_image || return
  fi
}

run_container() {
  declare -a docker_args=(
    run
    --cap-drop ALL
    --env "HOME=${home}"
    --env "TERM=${TERM:-xterm-256color}"
    --init
    --interactive
    --mount "type=bind,src=${group_file},dst=/etc/group,readonly"
    --mount "type=bind,src=${passwd_file},dst=/etc/passwd,readonly"
    --mount "type=bind,src=${state_dir}/home,dst=/home"
    --mount "type=bind,src=${workdir},dst=${workdir}"
    --read-only
    --rm
    --security-opt no-new-privileges:true
    --security-opt seccomp=unconfined
    --tmpfs '/tmp:rw,nosuid,nodev,mode=1777'
    --tty
    --user "${uid_host}:${gid_host}"
    --workdir "${workdir}"
  )

  if [[ -n "${OPENAI_API_KEY:-}" ]]; then
    docker_args+=(--env OPENAI_API_KEY)
  fi
  if [[ -d "${HOME}/.agents/skills" ]]; then
    docker_args+=(
      --mount "type=bind,src=${HOME}/.agents/skills,dst=${home}/.agents/skills,readonly"
    )
  fi

  exec docker "${docker_args[@]}" "${image}" "$@"
}

main() {
  declare script_path
  script_path="$(realpath -- "${BASH_SOURCE[0]}")" || return
  declare script_name
  script_name="$(basename -- "${script_path}")" || return
  declare script_directory
  script_directory="$(dirname -- "${script_path}")" || return
  declare project_directory
  project_directory="$(dirname "${script_directory}")" || return

  declare image workdir state_dir uid_host gid_host username groupname
  declare home passwd_file group_file
  declare -A kwargs=()
  declare -a args=()

  parse_arguments "$@" || return
  if [[ -n "${kwargs[help]+defined}" ]]; then
    __help
    return
  fi

  resolve_paths || return
  prepare_state_directory || return
  prepare_user_identity || return
  ensure_image || return
  run_container "${args[@]}" || return
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  main "$@"
fi
